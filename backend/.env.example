# ==========================================
# Backend Configuration Example
# ==========================================

# --- Core ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=your-django-secret-key-change-in-production
# MUST be False in production. When False, a real SECRET_KEY is required.
DJANGO_DEBUG=False
# Comma-separated. No wildcard in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database ---
# Leave unset for local SQLite. Set to Postgres in production:
# DATABASE_URL=postgres://user:password@localhost:5432/shp_restro_db

# --- Cache / Channels ---
# REDIS_URL=redis://127.0.0.1:6379/0

# --- CORS / CSRF ---
# Do NOT enable in production; leave False and use the allowlists below.
CORS_ALLOW_ALL_ORIGINS=False
# Comma-separated exact origins allowed to call the API (production frontend URL).
CORS_ALLOWED_ORIGINS=https://app.shptechnology.online
CSRF_TRUSTED_ORIGINS=https://app.shptechnology.online

# --- JWT lifetimes ---
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=1

# --- HTTPS / security (only applied when DJANGO_DEBUG=False) ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Razorpay Payment Gateway (from Razorpay Dashboard) ---
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
